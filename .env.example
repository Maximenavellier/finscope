# =========================================================
# FinScope — Variables d'environnement (Exemple)
# Copier en .env (backend/) pour le développement local
# =========================================================

# Base de données : SQLite en local, ou URL PostgreSQL Supabase en production
DATABASE_URL=sqlite:///./finscope.db

# Clés API gratuites (recommandées mais optionnelles grâce aux fallbacks Yahoo Finance)
# https://finnhub.io/register
FINNHUB_API_KEY=
# https://site.financialmodelingprep.com/register
FMP_API_KEY=

# Code PIN optionnel pour protéger l'accès en production (laisser vide en local)
APP_PIN=

# URL de production du frontend Vercel (ex: https://finscope-app.vercel.app)
FRONTEND_URL=

# Origines CORS additionnelles séparées par des virgules
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Paramètres de cache & concurrence
CACHE_TTL_QUOTE_MINUTES=15
CACHE_TTL_FUNDAMENTALS_HOURS=24
PEER_FETCH_CONCURRENCY=3

# Frontend (à mettre dans frontend/.env.local en local ou sur Vercel)
# NEXT_PUBLIC_API_URL=http://localhost:8000
